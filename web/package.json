{
  "name": "panel-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-dist.mjs",
    "typecheck": "tsc -b",
    "types": "cargo run --locked -p panel-common --example export_types",
    "types:check": "cargo run --locked -p panel-common --example export_types -- --check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.3",
    "antd": "6.6.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.9.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.23.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "xray_session"
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "AgentInput": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "Invoke": {
        "type": "object",
        "required": [
          "method",
          "path"
        ],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string"
          },
          "query": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "body": {},
          "confirmation": {
            "type": "string"
          }
        }
      },
      "XrayUserInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "AssignmentInput": {
        "type": "object",
        "required": [
          "user_id",
          "agent_id",
          "inbound_tag"
        ],
        "properties": {
          "user_id": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "inbound_tag": {
            "type": "string"
          },
          "adopt_email": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Agent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "url"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "version"
        ]
      },
      "XrayUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status"
        ]
      },
      "Assignment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "inbound_tag": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "native_user": {
            "type": "object",
            "additionalProperties": true
          },
          "desired_present": {
            "type": "boolean"
          },
          "generation": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "request": {
            "$ref": "#/components/schemas/Invoke"
          },
          "attempts": {
            "type": "integer"
          },
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {}
        }
      },
      "Effect": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "generation": {
            "type": "integer",
            "format": "int64"
          },
          "present": {
            "type": "boolean"
          },
          "native_user": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Preview": {
        "type": "object",
        "properties": {
          "confirmation": {
            "type": "string"
          },
          "revision": {
            "type": [
              "integer",
              "null"
            ]
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Effect"
            }
          },
          "restarts_xray": {
            "type": "boolean"
          },
          "request": {
            "$ref": "#/components/schemas/Invoke"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
